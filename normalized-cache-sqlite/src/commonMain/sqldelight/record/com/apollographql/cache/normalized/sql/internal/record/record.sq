CREATE TABLE record (
  key TEXT NOT NULL,
  chunk_index INTEGER NOT NULL,
  record BLOB NOT NULL,
  updated_date INTEGER NOT NULL
);

CREATE UNIQUE INDEX record_pk ON record(key, chunk_index);

-- Resumes from the last row read instead of skipping rows with OFFSET, which makes SQLite walk over
-- every page already read before returning the next one. `lastKey` = '' and `lastChunkIndex` = -1
-- sort before any row and so return the first page.
selectRecordsFrom:
SELECT key, chunk_index, record FROM record
WHERE key > :lastKey OR (key = :lastKey AND chunk_index > :lastChunkIndex)
ORDER BY key, chunk_index LIMIT :limit;

insertOrUpdateRecord:
INSERT INTO record (key, chunk_index, record, updated_date) VALUES (?, ?, ?, ?);

deleteRecordByKey:
DELETE FROM record WHERE key = ?;

deleteAllRecords:
DELETE FROM record;

count:
SELECT count(*) FROM record;

trimByUpdatedDate:
DELETE FROM record WHERE key IN (SELECT key FROM record ORDER BY updated_date LIMIT ?);

changes:
SELECT changes();

setCacheSize:
PRAGMA cache_size = -8192;
